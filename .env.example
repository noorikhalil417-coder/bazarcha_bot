# Bot token from BotFather; keep the real value private and out of source control.
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user IDs allowed to administer the bot.
ADMIN_IDS=
# Optional numeric group ID, usually a negative number such as -1001234567890.
GROUP_ID=
# Optional channel/group ID where approved ads are published.
AD_PUBLICATION_CHAT_ID=
DATABASE_PATH=/var/lib/bazaarche/bazaarche.sqlite3
LOG_LEVEL=INFO
DEFAULT_AD_EXPIRY_DAYS=30
MAX_ACTIVE_ADS_PER_USER=5
# required (default) or auto; auto publication still requires a destination.
MODERATION_REVIEW_MODE=required
BACKUP_DIRECTORY=/var/lib/bazaarche/backups
# Interval in hours; set 0 to disable scheduled backups.
AUTOMATIC_BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14
CLEANUP_RETENTION_DAYS=30
# Optional Persian text. Empty values use built-in Dari defaults.
WELCOME_MESSAGE=
GROUP_RULES=